# Copy this file to secrets.toml for LOCAL testing only.
# On Streamlit Community Cloud, do NOT upload this — instead paste these
# lines into: Manage app -> Settings -> Secrets

OPENAI_API_KEY = "sk-paste-your-key-here"
OPENAI_MODEL = "gpt-4o-mini"

# Team password gate. Set this before putting real candidate data online.
# Anyone with the app link must enter this password to use the app.
# If you leave APP_PASSWORD out entirely, the app stays open (no login).
APP_PASSWORD = "choose-a-strong-team-password"
